# Contact form delivery (https://resend.com) — without this the form will
# tell visitors to email directly instead of sending.
RESEND_API_KEY=

# Where enquiries land. Defaults to profile.email in src/lib/content.ts.
CONTACT_TO_EMAIL=gpaolobaltazar@gmail.com

# Must be an address on a domain you have verified in Resend.
# Resend's shared sandbox sender works for testing:
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
